{
  "name": "api-key-checker",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "productName": "API Key Checker",
  "author": "API Key Checker",
  "description": "GitHub Pages friendly API key environment variable checker with an optional local helper.",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/local.js",
    "web": "node server/static.js",
    "helper": "node server/helper.js",
    "check": "node --check src/app.js && node --check src/providers.js && node --check server/helper.js && node --check server/static.js && node --check scripts/local.js && node --check electron/main.js",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis msi --x64",
    "dist": "electron-builder --mac dmg --win nsis msi --x64"
  },
  "build": {
    "appId": "com.apikeychecker.desktop",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "server/**/*",
      "src/**/*",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
