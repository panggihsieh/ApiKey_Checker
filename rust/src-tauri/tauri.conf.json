{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "API Key Checker rust_release",
  "version": "0.1.3",
  "identifier": "com.apikeychecker.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../app"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
